	operating-points-v2 = <&clst_core_opp_table0_x100>, <&clst_core_opp_table1_x100>;
};

&cpu_8 {
	clocks = <&syscon_apmu CLK_APMU_CPU_C2_CORE>, <&syscon_apmu CLK_APMU_CPU_C3_CORE>;
	clock-names = "cls0", "cls1";
